# Required (MVP cannot start without these)
DEEPSEEK_API_KEY=sk-replace-me
OPENROUTER_API_KEY=sk-or-replace-me

# Optional (web research — pluggable search providers).
# Set RESEARCH_ENABLED=true to include the research stage in `irc run`.
# Configure at least one EN provider (Tavily/Brave) AND one ZH provider (Bocha)
# for full theme coverage. Jina Reader is the URL → markdown extractor.
RESEARCH_ENABLED=false

# English search via Tavily. Sign up: https://app.tavily.com/  (free tier ~1000/mo)
TAVILY_API_KEY=

# English news via Brave Search. Sign up: https://api.search.brave.com/  (free tier ~2000/mo)
BRAVE_API_KEY=

# Mainland-China search via 博查 Bocha AI. Sign up: https://open.bochaai.com/
BOCHA_API_KEY=

# URL → markdown extractor (Jina Reader). Free tier works without a key (rate-limited);
# paid tier at https://jina.ai/reader/ raises throughput.
JINA_API_KEY=

# SEC EDGAR fundamentals. SEC fair-use policy requires a valid, reachable contact
# email in the User-Agent for their public data API. Set to your email address;
# without it, EDGAR-based US filing fetches may be rate-limited or blocked.
EDGAR_CONTACT_EMAIL=

# Optional (OpenBB premium providers, MVP works without)
OPENBB_FMP_KEY=
OPENBB_TIINGO_KEY=
INTRINIO_API_KEY=   # from https://account.intrinio.com/account/api_keys/keys — enables FRED macro data
FRED_API_KEY=  # from https://fred.stlouisfed.org/docs/api/api_key.html — enables FRED macro data

# Optional feature flags
# Default: true. Set false to require real manager tenure for active funds.
ACTIVE_FUND_TENURE_PROXY_ENABLED=true

# Optional per-provider HTTPS proxy ({PROVIDER}_HTTPS_PROXY, uppercase).
# Set when a provider is geo-restricted (e.g., Anthropic models via OpenRouter
# from regions where Anthropic blocks direct traffic). Only that provider's
# LLM calls route through the proxy; data-source calls stay direct.
# OPENROUTER_HTTPS_PROXY=http://proxy.example.com:8080
# DEEPSEEK_HTTPS_PROXY=

# Optional proxy for akshare data-source calls (DXY index via EastMoney).
# Set if EastMoney's host is geo-restricted and DXY ingest fails with
# "Connection aborted / RemoteDisconnected".
# AKSHARE_HTTPS_PROXY=http://proxy.example.com:8080

# Roadmap (not used in MVP)
TUSHARE_TOKEN=
ANTHROPIC_API_KEY=

# Optional — set to true for verbose CLI logging + full tracebacks.
# Default: false. Errors during ingest are categorized in a summary either way.
DEBUG=false
