# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/

# Secrets
.env

# Project artifacts (gitignored, runtime-only)
data/
outputs/

# Local user/init artifacts — generated by `irc init` and edited per-user.
# Templates live in src/irc/templates/{config,inputs}; the root copies are
# user-specific (broker accounts, preferences, universe overrides) and must
# not be committed.
config/
inputs/

# Development artifacts — not part of the source tree
diff.txt
*.bak

# OS / Editor
.DS_Store
.idea/
.vscode/

# Coverage
.coverage
htmlcov/

# autodev-loop session pointer
.autodev-current

# Claude Code runtime state — generated by scheduled tasks, not part of the source tree
.claude/scheduled_tasks.lock

# Spend gate — machine-owned consumption ledger and learned profile (Phase 2 writes these)
data/spend/
