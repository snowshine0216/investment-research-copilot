# Required (MVP cannot start without these)
DEEPSEEK_API_KEY=sk-replace-me
OPENROUTER_API_KEY=sk-or-replace-me

# Optional (LDR self-hosted)
# Install: pipx install local-deep-research
# Start:   ldr-web                      (default port 5000)
#          LDR_WEB_PORT=5001 ldr-web    (use a different port if 5000 is occupied)
# Note: on macOS, port 5000 is taken by AirPlay Receiver — use LDR_WEB_PORT to override.
# Create an account at http://localhost:<port> on first run, then set credentials below.
LDR_ENABLED=false
LDR_BASE_URL=http://localhost:5000
LDR_USERNAME=
LDR_PASSWORD=
LDR_TIMEOUT_S=300  # seconds per theme query (quick_summary can take 3-5 min)
LDR_SEARCH_TOOL=  # override LDR search engine per-query (e.g. wikipedia, searxng, auto)

# Optional (OpenBB premium providers, MVP works without)
OPENBB_FMP_KEY=
OPENBB_TIINGO_KEY=
INTRINIO_API_KEY=   # from https://account.intrinio.com/account/api_keys/keys — enables FRED macro data
FRED_API_KEY=  # from https://fred.stlouisfed.org/docs/api/api_key.html — enables FRED macro data

# Optional feature flags
# Default: true. Set false to require real manager tenure for active funds.
ACTIVE_FUND_TENURE_PROXY_ENABLED=true

# Optional per-provider HTTPS proxy ({PROVIDER}_HTTPS_PROXY, uppercase).
# Set when a provider is geo-restricted (e.g., Anthropic models via OpenRouter
# from regions where Anthropic blocks direct traffic). Only that provider's
# LLM calls route through the proxy; data-source calls stay direct.
# OPENROUTER_HTTPS_PROXY=http://proxy.example.com:8080
# DEEPSEEK_HTTPS_PROXY=

# Optional proxy for akshare data-source calls (DXY index via EastMoney).
# Set if EastMoney's host is geo-restricted and DXY ingest fails with
# "Connection aborted / RemoteDisconnected".
# AKSHARE_HTTPS_PROXY=http://proxy.example.com:8080

# Roadmap (not used in MVP)
TUSHARE_TOKEN=
ANTHROPIC_API_KEY=
